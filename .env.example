# 株式会社888 コーポレートサイト 環境変数のひな形
# 実値は .env.local（ローカル）と App Hosting のシークレット（本番）に入れる。
# コードに直接書かない（指示書「絶対に守ること > 実装」）。

# --- 公開URL -------------------------------------------------
# [要確認] 未確定#2：ドメインの決定と取得が未了（.co.jp は即日取得できない）。
# 決まるまでは src/content/site.ts の暫定値が使われる。
NEXT_PUBLIC_SITE_URL=https://888.co.jp
NEXT_PUBLIC_MEDIA_URL=https://media.888.co.jp

# --- 以下は実装順序 4 以降で使う。今は未使用 -----------------
# CMS（実装順序4：CMS選定後に設定）
# CMS_API_KEY=
# CMS_SERVICE_DOMAIN=

# メール送信（実装順序5：問い合わせフォーム）
# [要確認] 未確定#3：問い合わせ通知先のメールアドレス
# MAIL_API_KEY=
# MAIL_TO=

# --- Firebase ------------------------------------------------
# [要確認] 未確定#9：Firebaseプロジェクトの作成とBlazeプランの請求先（CTO）
# [要確認] 未確定#10：HPとプロダクトでプロジェクトを分けるか（CTO）
# 実プロジェクトができるまでは、下のエミュレータ設定だけで動く。
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=demo-888-hp
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# ローカルは Firebase Emulator Suite に繋ぐ。本番では設定しない。
# ブラウザ側（client.ts）はこのフラグを見る。
NEXT_PUBLIC_USE_FIREBASE_EMULATOR=1
# サーバー側（Admin SDK）はこの3つを自動で拾う。本番では設定しない。
FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
FIREBASE_STORAGE_EMULATOR_HOST=127.0.0.1:9199

# App Hosting では Application Default Credentials が効くので不要。
# ローカルから実プロジェクトに繋ぎたいときだけ、サービスアカウントJSONを1行で入れる。
# FIREBASE_SERVICE_ACCOUNT=

# --- 執筆者ログイン（要件 NEW-02 / 6.6）----------------------
# ここに入れたドメインのGoogleアカウントだけが /admin に入れる。
# 空のままだと誰も入れない（開けっ放しにしないための既定値）。
# [要確認] 未確定#11：888の Google Workspace 管理ドメイン（CTO）
#   個人のGmailを共有している状態だとドメイン制限が成立しない。契約状況の確認が先。
AUTH_ALLOWED_DOMAIN=888incs.com
